<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Macrobenchmark needs the target app to be profileable (non-debuggable) so it can read
         accurate startup timing without the debug-runtime overhead. -->
    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>

</manifest>
